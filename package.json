{
  "name": "xauconnect-gold-router",
  "version": "0.1.0",
  "description": "XAUConnect Gold Router: multi-chain routing into tokenized gold on NEAR Intents (1Click API). Dry-run quotes, policy guardrails, agent-friendly HTTP API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "start": "node src/server.ts",
    "demo": "MOCK=1 node src/cli.ts plan --from 100:USDC:arb:0x0000000000000000000000000000000000000001 --from 60:USDT:eth:0x0000000000000000000000000000000000000001 --to XAUT:eth:DESTINATION_CHAIN:0x0000000000000000000000000000000000000001 --to XAUT:eth:INTENTS:demo.near",
    "plan": "node src/cli.ts plan",
    "tokens": "node src/cli.ts tokens",
    "fund": "node src/cli.ts fund",
    "patches": "scripts/build-xau-patches.sh"
  },
  "author": "Akhilesh Patil (https://github.com/akhilexx)",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhilexx/xauconnect-gold-router"
  },
  "homepage": "https://xauconnect.com",
  "keywords": [
    "near",
    "near-intents",
    "1click",
    "xaut",
    "gold",
    "cross-chain",
    "defi",
    "agents"
  ]
}
