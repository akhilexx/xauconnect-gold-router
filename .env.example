# Copy to .env. Never commit .env. This tool never needs a private key or seed phrase.

# 1 = offline simulated quotes from fixtures/tokens.json (no network, not real prices for fees)
MOCK=0

# NEAR Intents 1Click API. JWT is optional; without it 1Click adds an extra 0.2% fee (HACKATHON.md Q-006).
# Get one at https://docs.near-intents.org/integration/distribution-channels/1click-api/authentication
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# Public addresses only. Used as recipient/refund fields in dry-run quotes.
RECIPIENT_EVM=0xYourEvmAddress
REFUND_EVM=0xYourEvmAddress
REFUND_SOL=YourSolanaAddress
RECIPIENT_SOL=YourSolanaAddress
# NEAR account that receives into a NEAR Intents balance (mode INTENTS)
NEAR_ACCOUNT=your-account.near

# Optional 1Click referral tag for attribution
REFERRAL=xauconnect

# Policy guardrails (agents cannot exceed these)
POLICY_MAX_USD_PER_LEG=5000
POLICY_MAX_USD_TOTAL=10000
POLICY_MAX_SLIPPAGE_BPS=100
POLICY_MAX_COST_BPS=300
POLICY_ALLOWED_CHAINS=*
POLICY_ALLOWED_OUTPUTS=XAUT,USDC,USDT,SOL

# Deposit flow. Off unless exactly 1. Even then each execute call needs {"confirm": true}.
# 1Click has no testnet: with this on (and MOCK=0) execute requests a REAL deposit address. Leave unset.
EXECUTION_ENABLED=

# XAUConnect venue adapter (src/xauconnect/near-intents.ts). In this repo the venue is on unless set to false;
# in XAUConnect it defaults off. The router never builds deposits through the venue.
NEAR_INTENTS_ENABLED=true
NEAR_INTENTS_REFERRAL=

# Backlog 4: compare same-chain legs (e.g. USDT@eth -> XAUT@eth to a wallet) against XAUConnect's own quote
# (POST {XAUCONNECT_BASE_URL}/api/swap/quote, X-Client-Source: agent). Off unless 1. Quote only: such legs are
# a hand-off to xauconnect.com/swap and /v1/routes/:id/execute refuses them. MOCK=1 serves a price-only mock.
XAUCONNECT_COMPARE=0
XAUCONNECT_BASE_URL=https://xauconnect.com
XAUCONNECT_TIMEOUT_MS=5000

PORT=8787

# Hosted demo (render.yaml): read-only. Forces execute/deposit submit/build to 403 and rate limits POSTs per IP.
# The server refuses to start if this is combined with EXECUTION_ENABLED.
DEMO_PUBLIC=0
DEMO_RATE_PER_MIN=30
