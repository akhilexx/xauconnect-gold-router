# Copy to .env. Never commit .env. This tool never needs a private key or seed phrase.

# 1 = offline simulated quotes from fixtures/tokens.json (no network, not real prices for fees)
MOCK=0

# NEAR Intents 1Click API. JWT is optional; without it 1Click adds an extra 0.25% fee.
# Get one at https://docs.near-intents.org/integration/distribution-channels/1click-api/authentication
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# Public addresses only. Used as recipient/refund fields in dry-run quotes.
RECIPIENT_EVM=0xYourEvmAddress
REFUND_EVM=0xYourEvmAddress
REFUND_SOL=YourSolanaAddress
# NEAR account that receives into a NEAR Intents balance (mode INTENTS)
NEAR_ACCOUNT=your-account.near

# Optional 1Click referral tag for attribution
REFERRAL=xauconnect

# Policy guardrails (agents cannot exceed these)
POLICY_MAX_USD_PER_LEG=5000
POLICY_MAX_USD_TOTAL=10000
POLICY_MAX_SLIPPAGE_BPS=100
POLICY_MAX_COST_BPS=300
POLICY_ALLOWED_CHAINS=*
POLICY_ALLOWED_OUTPUTS=XAUT,USDC,USDT

PORT=8787
